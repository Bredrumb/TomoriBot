{$TOMORI_PUBLIC_HOST} {
  @oauth {
    method GET
    path /oauth/callback /oauth/mcp/start /oauth/client.json
  }
  handle @oauth {
    reverse_proxy tomoribot:8081
  }
  @submit {
    method POST
    path /oauth/mcp/confirm /supporter-billing/patreon/webhook
  }
  handle @submit {
    reverse_proxy tomoribot:8081
  }
  handle {
    respond 404
  }
}
