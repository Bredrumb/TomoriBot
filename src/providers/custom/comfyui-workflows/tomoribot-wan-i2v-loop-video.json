{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{TOMORI_REFERENCE_IMAGE_1_FILENAME}",
      "upload": "image"
    }
  },
  "2": {
    "class_type": "ImageScale",
    "inputs": {
      "image": ["1", 0],
      "upscale_method": "lanczos",
      "width": "{TOMORI_WIDTH}",
      "height": "{TOMORI_HEIGHT}",
      "crop": "center"
    }
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan",
      "device": "default"
    }
  },
  "4": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors",
      "weight_dtype": "default"
    }
  },
  "5": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors",
      "weight_dtype": "default"
    }
  },
  "6": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["4", 0],
      "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_high_noise.safetensors",
      "strength_model": 1
    }
  },
  "7": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["5", 0],
      "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_low_noise.safetensors",
      "strength_model": 1
    }
  },
  "8": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": ["6", 0],
      "shift": 5
    }
  },
  "9": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": ["7", 0],
      "shift": 5
    }
  },
  "10": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    }
  },
  "11": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["3", 0],
      "text": "{TOMORI_PROMPT}"
    }
  },
  "12": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["3", 0],
      "text": "overexposed, static, still image, blurry details, subtitles, watermark, text, low quality, worst quality, jpeg artifacts, malformed hands, malformed face, deformed limbs, extra fingers, fused fingers, duplicate subject, crowded background, bad anatomy"
    }
  },
  "13": {
    "class_type": "WanFirstLastFrameToVideo",
    "inputs": {
      "positive": ["11", 0],
      "negative": ["12", 0],
      "vae": ["10", 0],
      "start_image": ["2", 0],
      "end_image": ["2", 0],
      "width": "{TOMORI_WIDTH}",
      "height": "{TOMORI_HEIGHT}",
      "length": "{TOMORI_VIDEO_FRAME_COUNT}"
    }
  },
  "14": {
    "class_type": "KSamplerAdvanced",
    "inputs": {
      "add_noise": "enable",
      "noise_seed": "{TOMORI_SEED}",
      "steps": 4,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "start_at_step": 0,
      "end_at_step": 2,
      "return_with_leftover_noise": "enable",
      "model": ["8", 0],
      "positive": ["13", 0],
      "negative": ["13", 1],
      "latent_image": ["13", 2]
    }
  },
  "15": {
    "class_type": "KSamplerAdvanced",
    "inputs": {
      "add_noise": "disable",
      "noise_seed": 0,
      "steps": 4,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "start_at_step": 2,
      "end_at_step": 10000,
      "return_with_leftover_noise": "disable",
      "model": ["9", 0],
      "positive": ["13", 0],
      "negative": ["13", 1],
      "latent_image": ["14", 0]
    }
  },
  "16": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["15", 0],
      "vae": ["10", 0]
    }
  },
  "17": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["16", 0],
      "fps": "{TOMORI_VIDEO_FPS}"
    }
  },
  "18": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["17", 0],
      "filename_prefix": "tomoribot/generated_video",
      "format": "auto",
      "codec": "auto"
    }
  }
}
