# THROWAWAY — Phase 3 CHUNK 1 font/render gate (plans/stat-tracking.md §10).
#
# Validates the satori + @resvg/resvg-js stack INSIDE a font-less Bun-on-Alpine
# (musl) image — the same environment class as the production base. It proves the
# two things that actually matter for the gate:
#   1. `bun add` resolves @resvg/resvg-js's linux-x64-musl prebuild on Alpine
#      (musl libc) and it loads, and
#   2. satori + resvg rasterize Japanese from the bundled font buffer (no host
#      fonts, no fontconfig) — i.e. real glyphs, not tofu.
#
# DEVIATION (bandwidth): the prod Dockerfile uses oven/bun:1.3.3-alpine, but this
# spike uses oven/bun:1.2.12-alpine — the only bun-alpine image already cached
# locally — to avoid a slow re-pull. Same distro (Alpine/musl) and same Bun major,
# so the musl-prebuild + bufferless-font behaviour under test is identical. Also
# installs ONLY the two render libs (pinned to the lockfile versions) instead of
# the whole frozen dependency tree, since nothing else is on the render path.
#
# Build:  docker build -f docker/Dockerfile.spike -t tomori-stats-spike .
# Run:    docker run --rm -v "${PWD}/.spike-output-docker:/out" tomori-stats-spike
FROM oven/bun:1.2.12-alpine AS spike

WORKDIR /app

# Install only the render stack, pinned to the versions in the repo lockfile.
# This pulls the platform-matching native prebuild (@resvg/resvg-js-linux-x64-musl).
RUN bun add satori@0.26.0 @resvg/resvg-js@2.6.2

# tsconfig carries the JSX factory config the .tsx is transpiled with at runtime.
COPY tsconfig.json ./tsconfig.json
# Only what the spike needs: the satori layer, the bundled fonts, the spike script.
COPY src/utils/stats/statsInfographic.tsx ./src/utils/stats/statsInfographic.tsx
COPY assets/fonts/ ./assets/fonts/
COPY scripts/devtools/statsRenderSpike.ts ./scripts/devtools/statsRenderSpike.ts

# Write the artifacts to /out (bind-mounted at run time for extraction).
CMD ["bun", "run", "scripts/devtools/statsRenderSpike.ts", "/out"]
