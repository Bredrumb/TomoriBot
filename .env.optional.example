SEARXNG_SECRET=
SEARXNG_IMAGE_POOL=10
SEARXNG_IMAGE_COUNT=3

## Crawl4AI scraper sidecar
# Enable with 'docker compose --profile fetch-crawl4ai up' and set http://crawl4ai:11235/
CRAWL4AI_BASE_URL=
CRAWL4AI_TOKEN=
# JSON array of cookies for authenticated fetches: [{"name":"auth_token","value":"...","domain":".x.com"}]
CRAWL4AI_COOKIES_JSON=

