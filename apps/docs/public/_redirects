# Cloudflare Pages/Workers redirect rules. These are evaluated BEFORE static
# assets, so they upgrade the Astro-generated meta-refresh pages (which remain
# in the build as a fallback for non-Cloudflare hosting) to real 301s that
# preserve search-engine link equity.
#
# Rules must match the request path exactly, so each old URL is listed both
# with and without its trailing slash.

# Site root → introduction (the root page is only a redirect stub).
/ /introduction/ 301

# Japanese locale root → Japanese introduction (mirrors the root rule).
/ja /ja/introduction/ 301
/ja/ /ja/introduction/ 301

