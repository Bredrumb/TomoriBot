---
// Override of Starlight's MarkdownContent to prepend an "AI-generated"
// disclaimer note to every docs page at render time.
//
// Why render-time instead of injecting into each .md file:
//   1. The docs markdown stays clean — no 100+ file diff, no marker to migrate.
//   2. The note wording lives in exactly one place (below), trivially editable.
//   3. Opt-out is a single frontmatter flag, defaulted to true in the schema.
//
// The default MarkdownContent is just <div class="sl-markdown-content"><slot/></div>,
// so we render it and place the <Aside> as the first child — this keeps the note
// inside the markdown content flow, inheriting the correct prose spacing.
import Default from "@astrojs/starlight/components/MarkdownContent.astro";
import { Aside } from "@astrojs/starlight/components";

// Opt-out flag from frontmatter. Schema defaults it to true, so a page is
// treated as AI-generated unless it explicitly sets `aiGenerated: false`.
const showDisclaimer = Astro.locals.starlightRoute.entry.data.aiGenerated !== false;
---

<Default>
  {
    showDisclaimer && (
      <Aside type="note" title="Disclaimer">
        This specific page uses temporary drafts written and maintained by Generative AI. While verified to be accurate, please cross-verify with source code.
      </Aside>
    )
  }
  <slot />
</Default>
