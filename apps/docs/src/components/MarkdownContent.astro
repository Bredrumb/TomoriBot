---
// Override of Starlight's MarkdownContent to prepend a review disclaimer to every docs page at
// render time.
//
// Why render-time instead of injecting into each .md file:
//   1. The docs markdown stays clean: no 100+ file diff, no marker to migrate.
//   2. The wording lives in the shared locale table, so a new locale adds one entry.
//   3. Opt-out is a single frontmatter flag, defaulted to true in the schema.
//
// Locale awareness: a translated page is generated content, so it gets its own locale's wording. A
// translation whose source page is human-written (`aiGenerated: false` in the source frontmatter)
// shows the lighter "AI translation" notice instead of the full drafts disclaimer, because the
// content was authored by a person and only the translation is generated. Setting
// `aiGenerated: false` in the translated file itself, after a human reviews it, hides the notice
// entirely.
//
// The default MarkdownContent is just <div class="sl-markdown-content"><slot/></div>, so we render
// it and place the <Aside> as the first child: this keeps the note inside the markdown content flow,
// inheriting the correct prose spacing.
import Default from "@astrojs/starlight/components/MarkdownContent.astro";
import { Aside } from "@astrojs/starlight/components";
import { join } from "node:path";
import {
  DEFAULT_DOCS_LOCALE_ID,
  buildDefaultLocaleDocsPageUrl,
  getDocsLocaleConfig,
} from "@docs-locales";
import {
  localeFromEntryId,
  resolveTranslationNoticeMode,
  stripLocaleFromEntryId,
} from "../docsRouting";

// Content root (the src/content/docs junction pointing at repo-root docs/).
// Anchored to process.cwd() (the apps/docs project root during build) rather
// than import.meta.url: compiled .astro modules execute from dist/.prerender/,
// so a module-relative path would point at a directory that does not exist.
const docsRoot = join(process.cwd(), "src/content/docs");

// Reader-facing "AI translation of a human-written page" notice, disabled by default so unreviewed
// translations don't alarm readers. Review state is still tracked in frontmatter regardless: a
// translated file without `aiGenerated: false` is an unreviewed machine translation. Set
// DOCS_SHOW_TRANSLATION_NOTICE=true in the docs build environment to render it.
const showTranslationNotice =
  process.env.DOCS_SHOW_TRANSLATION_NOTICE?.trim().toLowerCase() === "true";

const { entry, locale: routeLocale } = Astro.locals.starlightRoute;

// The route locale rather than the entry's id prefix, because a fallback route carries the default
// locale's entry while still being served and read at the requested locale's URL.
const locale = routeLocale ?? localeFromEntryId(entry.id) ?? DEFAULT_DOCS_LOCALE_ID;
const baseId = stripLocaleFromEntryId(entry.id);
const notices = getDocsLocaleConfig(locale)?.notices ?? getDocsLocaleConfig(DEFAULT_DOCS_LOCALE_ID)?.notices;

// Opt-out flag from frontmatter. Schema defaults it to true, so a page is
// treated as generated unless it explicitly sets `aiGenerated: false`.
const mode = resolveTranslationNoticeMode({
  docsRoot,
  entryId: entry.id,
  locale,
  aiGenerated: entry.data.aiGenerated !== false,
});

// The notice links to the source page, which lives in the default locale and keeps English wording
// even on pages whose own locale has not translated it. The anchor is injected as HTML because the
// surrounding paragraph is authored per locale in the shared table, so it cannot be JSX here. No
// user input reaches this string.
const englishUrl = buildDefaultLocaleDocsPageUrl(baseId);
const englishLink = `<a href="${englishUrl}">${getDocsLocaleConfig(DEFAULT_DOCS_LOCALE_ID)?.label ?? "English"}</a>`;
const translatedBody = (notices?.translatedBody ?? "").replace("{english}", englishLink);
---

<Default>
  {
    mode === "drafts" && notices && (
      <Aside type="note" title={notices.draftsTitle}>
        {notices.draftsBody}
      </Aside>
    )
  }
  {
    mode === "translated" && showTranslationNotice && notices && (
      <Aside type="note" title={notices.translatedTitle}>
        <Fragment set:html={translatedBody} />
      </Aside>
    )
  }
  <slot />
</Default>
