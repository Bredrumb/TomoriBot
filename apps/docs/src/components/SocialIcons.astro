---
// Override of Starlight's SocialIcons to add a Ko-fi support link beside
// the GitHub icon in the header, both rendered larger than Starlight's
// 1em default. Ko-fi isn't part of Starlight's built-in icon set
// (`Icons.ts` in node_modules, not user-editable), so instead of fighting
// the `social` config's fixed icon enum, we reimplement the default's own
// tiny render loop (see @astrojs/starlight/components/SocialIcons.astro)
// so the GitHub icon's size is directly settable via Icon's `size` prop,
// then append one more hand-inlined monochrome Ko-fi mark sized to match.
// The path data below is lifted from a monochrome Ko-fi SVG on a
// 0 0 24 24 viewBox with no per-path fill, matching how every built-in
// icon is authored so it inherits currentColor / hover styling identically.
import { Icon } from "@astrojs/starlight/components";
import config from "virtual:starlight/user-config";

const ICON_SIZE = "1.5em";
const links = config.social || [];
---

{
  links.map(({ label, href, icon }) => (
    <a href={href} rel="me" class="sl-flex">
      <span class="sr-only">{label}</span>
      <Icon name={icon} size={ICON_SIZE} />
    </a>
  ))
}
<a href="https://ko-fi.com/J3J71O7NE6" rel="me" class="sl-flex" aria-label="Support on Ko-fi">
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style={`width: ${ICON_SIZE}; height: ${ICON_SIZE};`}>
    <path d="M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.022 11.822c.164 2.424 2.586 2.672 2.586 2.672s8.267-.023 11.966-.049c2.438-.426 2.683-2.566 2.658-3.734 4.352.24 7.422-2.831 6.649-6.916zm-11.062 3.511c-1.246 1.453-4.011 3.976-4.011 3.976s-.121.119-.31.023c-.076-.057-.108-.09-.108-.09-.443-.441-3.368-3.049-4.034-3.954-.709-.965-1.041-2.7-.091-3.71.951-1.01 3.005-1.086 4.363.407 0 0 1.565-1.782 3.468-.963 1.904.82 1.832 3.011.723 4.311zm6.173.478c-.928.116-1.682.028-1.682.028V7.284h1.77s1.971.551 1.971 2.638c0 1.913-.985 2.667-2.059 3.015z" />
  </svg>
</a>

<style>
  @layer starlight.core {
    a {
      color: var(--sl-color-text-accent);
      padding: 0.5em;
      margin: -0.5em;
    }
    a:hover {
      color: var(--sl-color-white);
    }
  }
</style>
