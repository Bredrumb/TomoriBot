---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { DOCS_LOCALES } from "@docs-locales";

const publishedLocales = DOCS_LOCALES.filter((locale) => locale.docsTree);
const title = "TomoriBot | Open-Source AI Agent & Roleplay Bot for Discord";
const description =
  "TomoriBot is a free and open-source AI agent and roleplaying bot for Discord with persistent memory, multiple personas, media generation, and multi-provider LLM support.";
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "TomoriBot",
  url: "https://docs.tomoribot.app/",
  image: "https://docs.tomoribot.app/img/social-banner.png",
  description,
  applicationCategory: "CommunicationApplication",
  operatingSystem: "Web",
  isAccessibleForFree: true,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  sameAs: ["https://github.com/Bredrumb/TomoriBot", "https://discord.gg/bjCfHm9QsB"],
});
---

<StarlightPage
  lang="en"
  dir="ltr"
  frontmatter={{
    title,
    description,
    template: "splash",
    pagefind: true,
    hero: {
      title: "Your AI companions, at home in Discord",
      tagline:
        "TomoriBot combines persistent memory, multiple personas, agentic tools, and media generation in a free, self-hostable Discord bot.",
      image: {
        html: '<img src="/tomoricon.svg" alt="TomoriBot" width="240" height="240">',
      },
      actions: [
        { text: "Read the docs", link: "/en/introduction/", icon: "open-book" },
        {
          text: "Invite TomoriBot",
          link: "https://discord.com/oauth2/authorize?client_id=841644102059556915",
          variant: "secondary",
          icon: "discord",
        },
        {
          text: "View on GitHub",
          link: "https://github.com/Bredrumb/TomoriBot",
          variant: "minimal",
          icon: "github",
        },
      ],
    },
    head: [
      { tag: "title", content: title },
      { tag: "link", attrs: { rel: "canonical", href: "https://docs.tomoribot.app/" } },
      { tag: "meta", attrs: { property: "og:type", content: "website" } },
      { tag: "meta", attrs: { property: "og:url", content: "https://docs.tomoribot.app/" } },
      { tag: "meta", attrs: { property: "og:title", content: "TomoriBot" } },
      { tag: "meta", attrs: { property: "og:description", content: description } },
      { tag: "script", attrs: { type: "application/ld+json" }, content: structuredData },
    ],
  }}
>
  <section class="root-section" aria-labelledby="choose-language">
    <div class="section-heading">
      <p class="eyebrow">Documentation</p>
      <h2 id="choose-language">Choose your language</h2>
      <p>Open the complete TomoriBot guide in any published language.</p>
    </div>
    <nav class="language-grid" aria-label="Documentation languages">
      {
        publishedLocales.map((locale) => (
          <a class="language-card" href={`/${locale.id}/introduction/`} lang={locale.lang} hreflang={locale.lang}>
            <span>{locale.label}</span>
            <small>{locale.id}</small>
          </a>
        ))
      }
    </nav>
  </section>

  <section class="root-section" aria-labelledby="built-for-discord">
    <div class="section-heading">
      <p class="eyebrow">One bot, many roles</p>
      <h2 id="built-for-discord">Built for practical help and creative play</h2>
    </div>
    <div class="value-grid">
      <article>
        <h3>Remembers what matters</h3>
        <p>Persistent server and personal memories give conversations continuity across channels and servers.</p>
      </article>
      <article>
        <h3>Adapts to your cast</h3>
        <p>Run multiple personas with their own prompts, memories, avatars, permissions, and provider settings.</p>
      </article>
      <article>
        <h3>Works with your stack</h3>
        <p>Connect hosted or local models, MCP tools, image and video workflows, speech services, and web search.</p>
      </article>
    </div>
  </section>
</StarlightPage>

<style>
  .root-section {
    margin-block: 4rem;
  }

  .section-heading {
    max-width: 44rem;
    margin-bottom: 1.5rem;
  }

  .section-heading h2 {
    margin-top: 0.25rem;
    font-size: var(--sl-text-3xl);
  }

  .section-heading p:last-child {
    color: var(--sl-color-gray-2);
  }

  .eyebrow {
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .language-grid,
  .value-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1rem;
  }

  .language-card,
  .value-grid article {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--sl-color-gray-6) 65%, transparent);
  }

  .language-card {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 1.1rem;
    color: var(--sl-color-white);
    font-weight: 650;
    text-decoration: none;
  }

  .language-card:hover {
    border-color: var(--sl-color-text-accent);
    color: var(--sl-color-text-accent);
  }

  .language-card small {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }

  .value-grid article {
    padding: 1.25rem;
  }

  .value-grid h3 {
    margin-top: 0;
    color: var(--sl-color-white);
  }

  .value-grid p {
    margin-bottom: 0;
    color: var(--sl-color-gray-2);
  }

  @media (max-width: 30rem) {
    .root-section {
      margin-block: 3rem;
    }
  }
</style>
