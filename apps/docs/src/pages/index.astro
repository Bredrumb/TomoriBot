---
// biome-ignore lint/correctness/noUnusedVariables: used in the Astro template below; biome doesn't parse template references
const target = "/introduction/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <link rel="icon" type="image/png" href="/tomoricon.png" sizes="256x256" />
    <link rel="apple-touch-icon" href="/tomoricon.png" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <title>Redirecting to TomoriBot docs</title>
  </head>
  <body>
    <a href={target}>Redirecting to TomoriBot docs</a>
  </body>
</html>
