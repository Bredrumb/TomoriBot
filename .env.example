# Required local setup values
# Copy this file to .env and fill in the placeholders.

# Discord Bot Configuration (Required)
DISCORD_TOKEN=your_discord_bot_token_here
# Make sure your Discord bot has the following Privileged Gateway Intents:
# GuildMembers, MessageContent, GuildPresences

# Security (Required)
CRYPTO_SECRET=your_32_character_crypto_secret_here

# Database Configuration (Required for local Bun setup)
# When using Docker Compose, only POSTGRES_PASSWORD is required because the rest is auto-configured.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_DB=tomodb

# Persona sprite limits/cache (optional)
# Sprites are custom per-persona webhook avatars selected by labels like "Tomori (mad):".
PERSONA_SPRITE_MAX_PER_PERSONA=50
PERSONA_SPRITE_MAX_INSTRUCTIONS_LENGTH=300
PERSONA_SPRITE_PROMPT_MAX_COUNT=20
PERSONA_SPRITE_CACHE_TTL_MINUTES=10
# Sprite messages display a clean persona name; the message -> sprite-label
# mapping is persisted so context rebuilding can recover "Name (sprite):".
# Retention bounds the mapping table; cache TTL bounds the in-memory lookup map.
PERSONA_SPRITE_MESSAGE_RETENTION_DAYS=30
PERSONA_SPRITE_MESSAGE_CACHE_TTL_MINUTES=120

# Persona user blocking (optional)
# Maximum block_user duration in hours; cache TTL bounds active block lookups.
BLOCK_USER_MAX_DURATION_HOURS=168
PERSONA_USER_BLOCK_CACHE_TTL_SECONDS=60

# Manual scene generation (optional)
# Maximum rounds accepted by /bot generate scene. Total generated turns are
# selected_character_count * rounds.
BOT_GENERATE_SCENE_MAX_CYCLES=3
