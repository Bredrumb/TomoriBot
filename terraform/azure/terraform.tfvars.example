# Copy to terraform.tfvars and fill in your values.
# Never commit terraform.tfvars - it is gitignored.

azure_subscription_id = "00000000-0000-0000-0000-000000000000"
azure_location        = "japanwest"

# Public half of the dedicated Phase 0 deploy keypair.
vm_admin_ssh_public_key = "ssh-ed25519 AAAA... gh-actions-deploy"

# Existing DCRs are retained; Terraform manages their associations to the VM.
vm_insights_data_collection_rule_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/tomoribot-rg/providers/Microsoft.Insights/dataCollectionRules/example-vm-insights-dcr"
application_logs_data_collection_rule_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/tomoribot-rg/providers/Microsoft.Insights/dataCollectionRules/example-application-logs-dcr"

# PostgreSQL password - store this securely; it is also used in TOMORI_SECRETS_JSON.
postgres_admin_password = "change-me"

# Exact operator egress IPv4 for the read-only Grafana PostgreSQL datasource.
grafana_egress_ip = "203.0.113.10"
